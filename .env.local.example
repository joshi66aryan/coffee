NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# The public origin of this deployment, e.g. https://app.sherpasips.com
# Supabase embeds this in the confirmation and password-reset links it mails.
# Leave it unset locally and the forwarded host is used; set it in production,
# and add "<origin>/auth/confirm" to Supabase → Authentication → URL
# Configuration → Redirect URLs, or the links will be rejected.
NEXT_PUBLIC_SITE_URL=

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ── Optional: database-level authorization tests (npm run test:rls) ──────────
# Deliberately NOT the variables above — this suite creates and deletes users,
# orders and storage objects. Point it at a branch database or `supabase start`,
# never at production.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
