NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# The public origin of this deployment, e.g. https://app.sherpasips.com
# Supabase embeds this in the confirmation and password-reset links it mails.
# Leave it unset locally and the forwarded host is used; set it in production.
#
# Supabase must also be told to trust it: set Authentication → URL Configuration
# → Site URL to the same origin, and add "<origin>/auth/confirm" to the Redirect
# URLs beneath it. A redirect target that is not on that list is not rejected
# outright — Supabase quietly substitutes the Site URL, which on a fresh project
# is still http://localhost:3000.
#
# Server-side only, so no NEXT_PUBLIC_ prefix: nothing in the browser reads it,
# and the prefix would bake it into the client bundle at build time.
SITE_URL=

# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# ── Optional: database-level authorization tests (npm run test:rls) ──────────
# Deliberately NOT the variables above — this suite creates and deletes users,
# orders and storage objects. Point it at a branch database or `supabase start`,
# never at production.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=
